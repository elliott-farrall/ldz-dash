{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.14.0/.schema/devbox.schema.json",
  "packages": [
    "python@3.10",
    "poetry@latest",
    "ruff@latest",
    "openssl@latest",
    "pre-commit@latest",
    "treefmt@latest",
    "actionlint@latest",
    "beautysh@latest",
    "isort@latest",
    "jsonfmt@latest",
    "mdformat@latest",
    "nodePackages.prettier@latest",
    "shfmt@latest",
    "taplo@latest",
    "yamlfmt@latest",
    "uwsgi@latest",
    "inotify-tools@latest"
  ],
  "shell": {
    "init_hook": [
      "pre-commit install --install-hooks",
      "poetry install",
      "clear"
    ],
    "scripts": {
      "install": "./install.sh",
      "app": "poetry run ldz",
      "test": "wsgi/test.sh"
    }
  }
}
